// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model FoundationTest {
  id      Int    @id @default(autoincrement())
  message String
}

model User {
  id           Int      @id @default(autoincrement())
  username     String   @unique
  displayName  String
  email        String   @unique
  passwordHash String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  hostedRooms  Room[]   @relation("RoomHost")
  roomPlayers RoomPlayer[]
  sessions Session[]
  chatMessages ChatMessage[]
  gamePlayers GamePlayer[]

  @@map("users")
}

model Session {
  id        Int      @id @default(autoincrement())
  tokenHash String   @unique
  userId    Int
  createdAt DateTime @default(now())
  expiresAt DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("sessions")
}

model Room {
  id         String   @id @default(uuid()) @db.Uuid
  name       String
  hostId     Int
  maxPlayers Int
  status     RoomStatus  @default(WAITING)
  isPrivate  Boolean
  inviteCode String?  @unique
  createdAt  DateTime @default(now())

  host       User     @relation("RoomHost", fields: [hostId], references: [id])
  players RoomPlayer[]
  chatMessages ChatMessage[]

  @@map("rooms")
  game Game?
}

model RoomPlayer {
  roomId   String   @db.Uuid
  userId   Int      @unique
  joinedAt DateTime @default(now())

  room Room @relation(fields: [roomId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([roomId, userId])
  @@map("room_players")
}

model Game{
  id                      String      @id @db.Uuid
  roomId                  String      @unique @db.Uuid
  phase                   GamePhase
  currentRoundNumber      Int
  secretWord              String
  phaseEndsAt             DateTime?
  winner                  GameWinner?
  terminationReason       TerminationReason?
  startedAt               DateTime
  endedAt                 DateTime?

  room Room @relation(fields: [roomId], references: [id], onDelete: Restrict)
  players GamePlayer[]
  rounds GameRound[]

  @@map("games")
}

model GamePlayer {
  id                  Int                 @id @default(autoincrement())
  gameId              String              @db.Uuid
  userId              Int
  role                GameRole
  participationStatus ParticipationStatus
  connectionStatus    ConnectionStatus

  game Game @relation(fields: [gameId], references: [id], onDelete: Restrict)
  user User @relation(fields: [userId], references: [id], onDelete: Restrict)
  votesCast     Vote[] @relation("VoteVoter")
  votesReceived Vote[] @relation("VoteTarget")
  eliminatedInRounds GameRound[]
  clues Clue[]

  @@unique([gameId, userId])
  @@map("game_players")
}

model GameRound {
  id                     Int           @id @default(autoincrement())
  gameId                 String        @db.Uuid
  number                 Int
  outcome                RoundOutcome?
  eliminatedGamePlayerId Int?
  resolvedAt             DateTime?

  game                 Game        @relation(fields: [gameId], references: [id], onDelete: Restrict)
  eliminatedGamePlayer GamePlayer? @relation(fields: [eliminatedGamePlayerId], references: [id], onDelete: Restrict)
  clues Clue[]
  votes Vote[]

  @@unique([gameId, number])
  @@map("game_rounds")
}

model Clue {
  id                 Int      @id @default(autoincrement())
  roundId            Int
  authorGamePlayerId Int
  text               String   @db.VarChar(100)
  normalizedText     String   @db.VarChar(100)
  submittedAt        DateTime

  round  GameRound  @relation(fields: [roundId], references: [id], onDelete: Restrict)
  author GamePlayer @relation(fields: [authorGamePlayerId], references: [id], onDelete: Restrict)

  @@unique([roundId, authorGamePlayerId])
  @@unique([roundId, normalizedText])
  @@map("clues")
}

model Vote {
  id                 Int      @id @default(autoincrement())
  roundId            Int
  voterGamePlayerId  Int
  targetGamePlayerId Int
  submittedAt        DateTime

  round  GameRound  @relation(fields: [roundId], references: [id], onDelete: Restrict)
  voter  GamePlayer @relation("VoteVoter", fields: [voterGamePlayerId], references: [id], onDelete: Restrict)
  target GamePlayer @relation("VoteTarget", fields: [targetGamePlayerId], references: [id], onDelete: Restrict)

  @@unique([roundId, voterGamePlayerId])
  @@map("votes")
}

model ChatMessage {
  id        Int         @id @default(autoincrement())
  roomId    String      @db.Uuid
  userId    Int
  channel   ChatChannel
  content   String      @db.VarChar(300)
  createdAt DateTime    @default(now())

  room Room @relation(fields: [roomId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@index([roomId, channel, createdAt])
  @@index([userId])
  @@map("chat_messages")
}


enum RoomStatus {
  WAITING
  IN_GAME
  FINISHED
  CLOSED
}

enum GamePhase {
  ROLE_ASSIGNMENT
  CLUE_SUBMISSION
  DISCUSSION
  VOTING
  FINISHED
  TERMINATED
}

enum GameWinner {
  SPY
  DETECTIVES
}

enum TerminationReason {
  SPY_DEPARTED
  INSUFFICIENT_PLAYERS
}

enum GameRole {
  SPY
  DETECTIVE
}

enum ParticipationStatus {
  ACTIVE
  ELIMINATED
  DEPARTED
}

enum ConnectionStatus {
  CONNECTED
  DISCONNECTED
}
enum RoundOutcome {
  ELIMINATED
  TIE
  NO_VOTES
}

enum ChatChannel {
  LOBBY
  DISCUSSION
}